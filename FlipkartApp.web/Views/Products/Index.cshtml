@model List<FlipkartApp.Data.Product>

<h2>Available Products</h2>

<table class="table">
    <tr>
        <th>Name</th>
        <th>Price</th>
        <th>Description</th>
    </tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Name</td>
            <td>@p.Price</td>
            <td>@p.Description</td>
        </tr>
    }
</table>
